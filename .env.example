# Sigma Core OS - environment variables
# Copy to .env and fill in values

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime store mode. Production Railway should use postgres.
# Local development can omit this or set sqlite.
SIGMA_CONTROL_STORE=sqlite

# Postgres URL for SIGMA_CONTROL_STORE=postgres.
# DATABASE_URL=postgres://user:password@host:5432/db

# Local SQLite fallback path (default: ./sigma.db).
DB_PATH=./sigma.db

# ---------------------------------------------------------------------------
# Redis task queue
# ---------------------------------------------------------------------------
# Production Railway can set TASK_QUEUE_MODE=redis to move agent execution out
# of the API process. Local development defaults to inline mode when REDIS_URL
# is absent.
# REDIS_URL=redis://default:password@host:6379
TASK_QUEUE_MODE=inline
TASK_QUEUE_NAME=sigma:tasks
TASK_WORKER_POLL_SECONDS=5
TASK_RESULT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# LLM - core/llm/index.ts
# ---------------------------------------------------------------------------

# LiteLLM proxy base URL (hosted)
# For hosted LiteLLM:   https://your-litellm-host.example.com/v1
# For OpenAI direct:    https://api.openai.com/v1
# For local Ollama:     http://localhost:11434/v1  (future)
LLM_BASE_URL=https://api.openai.com/v1

# Model name - passed to LiteLLM / OpenAI
# Primary:   gpt-4o
# Fallback:  claude-3-5-sonnet-20241022  (future)
LLM_MODEL=gpt-4o

# API key - required for all LLM calls
# LiteLLM proxy key, or your OpenAI key directly
LLM_API_KEY=sk-...

# Request timeout in milliseconds (default: 30000)
LLM_TIMEOUT_MS=30000

# Max retries on 429 / 5xx errors, with exponential backoff (default: 2)
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Voice - core/voice/index.ts
# ---------------------------------------------------------------------------

# Default voice path: OpenRouter with Microsoft MAI audio models
VOICE_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
VOICE_STT_MODEL=microsoft/mai-transcribe-1.5
VOICE_TTS_MODEL=microsoft/mai-voice-2
VOICE_TTS_VOICE=en-US-Harper:MAI-Voice-2
VOICE_TTS_FORMAT=mp3
VOICE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------

# Cloud-safe futures OHLC data source. Keep broker/OpenD sessions local.
MARKET_DATA_PROVIDER=massive
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_API_KEY=...

# OpenAI alternative:
# VOICE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# VOICE_STT_MODEL=gpt-4o-mini-transcribe
# VOICE_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS_VOICE=nova

# ---------------------------------------------------------------------------
# GitHub - apps/api/server.ts
# ---------------------------------------------------------------------------

# GitHub Personal Access Token (classic or fine-grained)
# Required for MindLyft dashboard to fetch Jules tasks and PRs without strict rate limiting.
GITHUB_TOKEN=ghp_...
